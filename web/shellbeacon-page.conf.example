# shellbeacon-page.conf - station configuration for shellbeacon-page.py
# Copy to /usr/local/etc/shellbeacon-page.conf and edit. No secrets in
# this file - it is safe to keep readable. (Your APRS passcode stays in
# shellbeacon.conf, which this file does not touch.)

# --- station identity ---
callsign="N0CALL"             # your callsign, as transmitted
place="Nowhere, Texas"        # shown under the callsign
lat="29.0000"                 # station latitude, decimal degrees
lon="-98.0000"                # station longitude, decimal degrees
# grid="EL09sp"               # optional - computed from lat/lon if unset
comment="My APRS station"     # your station comment, as transmitted
about="on a Raspberry Pi."    # continues the sentence "ShellBeacon ..."
# repo_url="https://github.com/robertmcatee/shellbeacon-telemetry"
                              # if set, the word "ShellBeacon" in the
                              # About section links here
# footer_extra=""             # raw HTML appended to the page footer

# --- paths ---
webroot="/var/www/html/station"     # where index.html + JSON are written
statedir="/var/lib/shellbeacon-page"  # the 24 h temperature history
wxfile="/home/pi/wx/latest.json"    # the wx-collect.sh output file
beacon_dir="/var/aprs-beacon"       # where rf.enabled / voice.enabled live
beacon_unit="aprs-beacon"           # the beacon's systemd unit (journal)
# map_features=""             # optional JSON: towns, highways, rivers
                              # drawn on the locator chart - see
                              # map-features.example.json
# map_base=""                 # optional real basemap JPEGs for the
                              # charts, built once by make-basemap.py:
                              # map_base = subsquare view, map_square =
                              # square view, map_range = range view,
                              # map_hamlet = hamlet view, map_club =
                              # club view. Each names
                              # the DARK file; its "-light" twin must
                              # sit beside it. With a basemap the drawn
                              # geography is replaced.
# map_hamlet=""               # the hamlet view's basemap (above)
# map_club=""                 # the club view's basemap (above)
# club_file=""                # optional JSON: the club view's marked
                              # places (the ring itself is computed -
                              # the CLUB_* constants in
                              # shellbeacon-page.py / make-basemap.py
                              # set its radius and frame)
# hamlet_file=""              # optional JSON: the hamlet boundary
                              # polygon (drawn dashed, following the
                              # roads that bound the station's home
                              # ground) and its practical places -
                              # see hamlet.example.json. The hamlet
                              # bounds are the HAMLET_* constants in
                              # shellbeacon-page.py / make-basemap.py;
                              # set them to your own ground.

# --- station facts shown on the page ---
rf_freq="144.390"
voice_freq="146.430"
beacon_interval_min="20"

# --- staleness thresholds (minutes) ---
wx_stale_min="40"             # match the beacon's WX fold-in threshold
beacon_stale_min="45"
